@page "/professor/RelatoriosProfessor"
@using gestaopedagogica.Models
@using gestaopedagogica.Services
@using System.Security.Claims
@inject ProfessorService ProfessorService
@inject TrabalhoService TrabalhoService
@inject IAService IAService
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-0">Painel de Avaliação Docente</h3>
            <p class="text-muted">Análise de desempenho, entregas e planos de recuperação</p>
        </div>
        <span class="badge bg-primary px-3 py-2">Sessão: @DateTime.Now.Year/@(DateTime.Now.Year + 1)</span>
    </div>

    @* Cartões de Resumo *@
    <div class="row mb-4 g-3">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 border-start border-primary border-4">
                <small class="text-muted fw-bold">MÉDIA GLOBAL</small>
                <h3 class="fw-bold mb-0">@(Medias.Any() ? Medias.Average().ToString("F1") : "0.0")</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 border-start border-danger border-4">
                <small class="text-muted fw-bold">ALUNOS EM RECUPERAÇÃO</small>
                <h3 class="fw-bold mb-0 text-danger">@TotalEmRecuperacao</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-3 border-start border-success border-4">
                <small class="text-muted fw-bold">TAXA DE ENTREGA</small>
                <h3 class="fw-bold mb-0 text-success">@TaxaEntregaGlobal.ToString("F0")%</h3>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-4 text-muted">Desempenho por Turma (Média)</h5>
                @if (!Labels.Any() && !IsLoading)
                {
                    <div class="text-center py-5">
                        <p class="text-muted">Sem dados para exibir no gráfico.</p>
                    </div>
                }
                <div style="position: relative; height:350px; width:100%">
                    <canvas id="chartTurmas"></canvas>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 bg-white h-100 d-flex flex-column">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-robot text-primary me-2"></i>Análise IA</h5>
                    @if (!isGerandoAnalise)
                    {
                        <button class="btn btn-sm btn-outline-primary" @onclick="ChamarIA">
                            <i class="bi bi-magic"></i> Gerar
                        </button>
                    }
                </div>

                <div class="flex-grow-1">
                    @if (isGerandoAnalise)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-grow text-primary" role="status"></div>
                            <p class="small text-muted mt-2">A analisar dados das turmas...</p>
                        </div>
                    }
                    else
                    {
                        <div class="p-3 rounded-3 mb-3" style="background: #f8f9fc; border-left: 4px solid #4e73df; min-height: 100px;">
                            <p class="small mb-0 text-dark" style="line-height: 1.6; white-space: pre-line;">@analiseIA</p>
                        </div>
                    }
                </div>

                <h6 class="fw-bold mt-3 mb-3 small">Métricas Rápidas:</h6>
                <div class="list-group list-group-flush small" style="max-height: 200px; overflow-y: auto;">
                    @foreach (var item in DadosTurmas)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center px-0">
                            <div>
                                <span class="fw-bold">@item.Nome</span>
                                <div class="text-muted" style="font-size: 0.7rem;">Entregas: @item.PercentualEntrega.ToString("F0")%</div>
                            </div>
                            <span class="badge @(item.Media >= 10 ? "bg-success" : "bg-warning text-dark")">@item.Media.ToString("F1")</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<string> Labels = new();
    private List<double> Medias = new();
    private List<TurmaDashboardItem> DadosTurmas = new();
    private int TotalEmRecuperacao = 0;
    private double TaxaEntregaGlobal = 0;
    private string analiseIA = "Clique no botão 'Gerar' para obter um diagnóstico  das suas turmas.";
    private bool isGerandoAnalise = false;
    private bool shouldRenderChart = false;
    private bool IsLoading = true;
    private string? CurrentUserId;

    public class TurmaDashboardItem
    {
        public string Nome { get; set; } = "";
        public double Media { get; set; }
        public int QtdRecuperacao { get; set; }
        public double PercentualEntrega { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            IsLoading = true;
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            CurrentUserId = auth.User.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;

            if (string.IsNullOrEmpty(CurrentUserId)) return;

            var professor = await ProfessorService.GetProfessorByUserIdAsync(CurrentUserId);
            if (professor == null) return;

            var turmas = await ProfessorService.GetTurmasDoProfessorAsync(professor.Id);
            var trabalhos = await TrabalhoService.GetTodosTrabalhosComNotasAsync();

            DadosTurmas = turmas.Select(turma =>
            {
                var trabTurma = trabalhos.Where(t => t.TurmaId == turma.Id && t.ProfessorId == CurrentUserId).ToList();
                var vertentes = trabTurma.SelectMany(t => t.TrabalhoVertentes ?? new List<TrabalhoVertente>()).ToList();
                var notas = vertentes.Where(v => v.Nota.HasValue).Select(v => (double)v.Nota!.Value).ToList();

                int totalEsperado = vertentes.Count;
                int totalEntregue = vertentes.Count(v => v.DataEnvio.HasValue || !string.IsNullOrEmpty(v.ConteudoTextoAluno));

                return new TurmaDashboardItem
                {
                    Nome = turma.Nome,
                    Media = notas.Any() ? Math.Round(notas.Average(), 1) : 0,
                    QtdRecuperacao = trabTurma.Count(t => t.IsPlanoRecuperacao),
                    PercentualEntrega = totalEsperado > 0 ? ((double)totalEntregue / totalEsperado) * 100 : 0
                };
            }).OrderByDescending(x => x.Media).ToList();

            Labels = DadosTurmas.Select(d => d.Nome).ToList();
            Medias = DadosTurmas.Select(d => d.Media).ToList();
            TotalEmRecuperacao = DadosTurmas.Sum(d => d.QtdRecuperacao);
            TaxaEntregaGlobal = DadosTurmas.Any() ? DadosTurmas.Average(d => d.PercentualEntrega) : 0;

            shouldRenderChart = true;
        }
        finally
        {
            IsLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (shouldRenderChart && Labels.Any())
        {
            await JS.InvokeVoidAsync("site.renderBarChart", "chartTurmas", Labels.ToArray(), Medias.ToArray(), Labels.Select(_ => "#4e73df").ToArray());
            shouldRenderChart = false;
        }
    }

    private async Task ChamarIA()
    {
        if (string.IsNullOrEmpty(CurrentUserId) || !DadosTurmas.Any()) return;

        try
        {
            isGerandoAnalise = true;
            StateHasChanged();

            var resumo = string.Join(" | ", DadosTurmas.Select(d => $"{d.Nome}: Média {d.Media}, Entregas {d.PercentualEntrega:F0}%"));

            // Chamada à API da Groq
            analiseIA = await IAService.ObterSugestoes(
                "Coordenador Pedagógico",
                "Analise o desempenho destas turmas. Seja direto e sugira ações para turmas com média abaixo de 10.",
                resumo,
                CurrentUserId,
                "REPORT_PROF",
                "0",
                null
            );
        }
        catch (Exception)
        {
            analiseIA = "Erro ao conectar com a IA. Verifique a chave da API ou a sua ligação.";
        }
        finally
        {
            isGerandoAnalise = false;
            StateHasChanged();
        }
    }
}